{
  "manifest_version": 3,
  "name": "GitHub Knowledge Assistant",
  "version": "1.0.0",
  "description": "Evidence-backed repository exploration & pull-request change-impact analysis",
  "permissions": ["sidePanel", "storage", "activeTab", "scripting"],
  "host_permissions": ["https://github.com/*", "http://localhost:8787/*"],
  "background": {
    "service_worker": "src/background/service-worker.ts"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/content/content-script.ts"]
    }
  ],
  "action": {},
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
